# Supabase — hew class schedule management (ref: oslyorggjaeejkvpfhif)
NEXT_PUBLIC_SUPABASE_URL=https://oslyorggjaeejkvpfhif.supabase.co
# Project Settings → API Keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API Keys → service_role  (서버 전용 — 절대 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# ── 서류 만료 알림 이메일 (작업지시서 #006) ──
# 알림 수신 담당자 이메일 (필수 — 없으면 알림 스킵)
STAFF_NOTIFY_EMAIL=
# Vercel Cron 인증용 시크릿. 설정하면 /api/cron/* 호출 시 Bearer 로 검증
CRON_SECRET=
# Resend API 키. 미설정이면 실제 발송 대신 로그만(simulated)
RESEND_API_KEY=
# 발신 주소 (미설정 시 onboarding@resend.dev). 예: "HEW <alert@yourdomain.com>"
RESEND_FROM_EMAIL=
# 이메일 본문 링크에 쓰는 배포 URL. 예: https://hew.example.com
NEXT_PUBLIC_SITE_URL=
